-- ====== CLASSE PRINCIPAL DO SCRIPT ======
local ApexScript = {}
ApexScript.__index = ApexScript

function ApexScript.new()
    local self = setmetatable({}, ApexScript)
    
    -- Configurações
    self.Config = {
        bringItemsSpeed = 1.5,
        espUpdateSpeed = 2,
        playerEspUpdateSpeed = 0.1,
    }
    
    -- Estados
    self.States = {
        bringMetals = false,
        bringItems = false,
        speedHack = false,
        speedHackWhileFlying = false,
        fly = false,
        infJump = false,
        itemEsp = false,
        playerEsp = false,
    }
    
    -- Rastreamento de objetos
    self.Tracking = {
        broughtItems = {}, -- {object = CFrame}
        espLabels = {}, -- {object = BillboardGui}
        playerHighlights = {}, -- {player = Highlight}
        playerLabels = {}, -- {player = BillboardGui}
        activeThreads = {}, -- Threads ativas
    }
    
    -- Dados salvos
    self.OriginalGravity = workspace.Gravity
    self.FlySpeedMultiplier = 5
    
    -- Configurações de itens
    self.MetaisParaTrazer = {"Metal", "ScrapMetal", "ESP Metal"}
    self.ItensParaTrazer = {"BrokenCrate", "BrokenCrate2", "Plank"}
    self.ArmasSuportadas = {"Machete", "Machado", "Arpão", "Machete ", "Machado ", "Arpão "}
    self.LootKeywords = {"scrap", "metal", "barrel", "crate", "box", "plank", "bolt", "leaf", "chest"}
    
    -- UI
    self.UI = {}
    self.MinimizedState = false
    
    return self
end

-- ====== UTILITÁRIOS ======
function ApexScript:SafeCall(func, ...)
    local success, result = pcall(func, ...)
    if not success then
        warn("[Sherlock] Erro em SafeCall: " .. tostring(result))
    end
    return result
end

function ApexScript:IsValidCharacter(character)
    return character and character.Parent and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid")
end

function ApexScript:IsTeammate(player)
    if not player then return false end
    if not LP.Team then return false end
    return player.Team == LP.Team
end

function ApexScript:GetPlayerFromCharacter(character)
    return Players:FindFirstChildOfClass("Player", function(p)
        return p.Character == character
    end) or Players:GetPlayerFromCharacter(character)
end

function ApexScript:CleanupDestroyedItems()
    for item, _ in pairs(self.Tracking.broughtItems) do
        if not item.Parent then
            self.Tracking.broughtItems[item] = nil
        end
    end
end

function ApexScript:CleanupDestroyedEspLabels()
    for item, label in pairs(self.Tracking.espLabels) do
        if not item.Parent or not label.Parent then
            if label and label.Parent then
                label:Destroy()
            end
            self.Tracking.espLabels[item] = nil
        end
    end
end

-- ====== FUNÇÕES DE EXPLOIT (COM FALLBACKS) ======
function ApexScript:GetExploitFunctions()
    local virtUser = nil
    local getGarbageCollector = nil
    local fireTouchInterest = nil
    
    -- Tenta carregar VirtualUser
    if typeof(VirtualUser) == "userdata" then
        virtUser = VirtualUser
    elseif game:FindFirstChildOfClass("VirtualUser") then
        virtUser = game:FindFirstChildOfClass("VirtualUser")
    else
        pcall(function()
            virtUser = game:GetService("VirtualUser")
        end)
    end
    
    -- Tenta carregar getgc
    if type(getgc) == "function" then
        getGarbageCollector = getgc
    end
    
    -- Tenta carregar firetouchinterest
    if type(firetouchinterest) == "function" then
        fireTouchInterest = firetouchinterest
    end
    
    return {
        VirtualUser = virtUser,
        getgc = getGarbageCollector,
        fireTouchInterest = fireTouchInterest,
    }
end

function ApexScript:ClickTarget(part)
    local screenPos, onScreen = Camera:WorldToScreenPoint(part.Position)
    if not onScreen then return end
    
    local exploit = self:GetExploitFunctions()
    if exploit.VirtualUser then
        exploit.VirtualUser:CaptureController()
        exploit.VirtualUser:Button1Down(Vector2.new(screenPos.X, screenPos.Y), Camera.CFrame)
        exploit.VirtualUser:Button1Up(Vector2.new(screenPos.X, screenPos.Y), Camera.CFrame)
    end
end

