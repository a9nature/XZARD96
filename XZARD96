-- 1. BRING METALS - COM FÍSICA ATIVA
function ApexScript:ToggleBringMetals(btn)
    self.States.bringMetals = not self.States.bringMetals
    btn.Text = self.States.bringMetals and "BRING METALS: ACTIVE" or "BRING METALS: OFF"
    
    if not self.States.bringMetals then
        table.clear(self.CacheMetals)
    end
    
    if self.States.bringMetals then
        local thread = task.spawn(function()
            local metalSet = {}
            for _, name in pairs(self.MetaisParaTrazer) do metalSet[name] = true end
            
            while self.States.bringMetals do
                self:SafeCall(function()
                    if self:IsValidCharacter(LP.Character) then
                        local meuCFrame = LP.Character.HumanoidRootPart.CFrame * CFrame.new(0, 3, -8)
                        
                        for _, v in pairs(workspace:GetDescendants()) do
                            if not (v:IsA("BasePart") or v:IsA("Model")) then continue end
                            if v:IsDescendantOf(LP.Character) then continue end
                            if not v.Parent then continue end
                            
                            if metalSet[v.Name] then
                                local jaTrazido = table.find(self.CacheMetals, v)
                                if not jaTrazido then
                                    self:ManageCache(self.CacheMetals, v)
                                    self:MoveObject(v, meuCFrame)
                                    self:EnablePhysics(v)
                                end
                            end
                        end
                        collectgarbage("step", 1)
                    end
                end)
                task.wait(self.Config.bringItemsSpeed)
            end
        end)
        table.insert(self.Tracking.activeThreads, thread)
    end
end

