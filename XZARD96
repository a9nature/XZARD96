function ApexScript:InitializeInfiniteJump()
    UIS.JumpRequest:Connect(function()
        if self.States.infJump and self:IsValidCharacter(LP.Character) then
            LP.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end

-- 6. INSTANT INTERACT
function ApexScript:InstantInteract()
    local exploit = self:GetExploitFunctions()
    if exploit.getgc then
        for _, v in pairs(exploit.getgc(true)) do
            if type(v) == "table" and (rawget(v, "CollectionTime") or rawget(v, "HoldTime")) then
                v.CollectionTime = 0
                v.HoldTime = 0
            end
        end
        return true
    end
    return false
end

-- 7. ITEM ESP
function ApexScript:ToggleItemEsp(btn)
    self.States.itemEsp = not self.States.itemEsp
    btn.Text = self.States.itemEsp and "ITEM ESP: ACTIVE" or "ITEM ESP: OFF"
    
    if not self.States.itemEsp then
        for _, label in pairs(self.Tracking.espLabels) do
            if label and label.Parent then
                label:Destroy()
            end
        end
        self.Tracking.espLabels = {}
    else
        local thread = task.spawn(function()
            while self.States.itemEsp do
                self:SafeCall(function()
                    self:CleanupDestroyedEspLabels()
                    
                    for _, v in pairs(workspace:GetDescendants()) do
                        if (v:IsA("BasePart") or v:IsA("Model")) and v.Parent then
                            local nameLower = v.Name:lower()
                            local isLoot = false
                            
                            for _, key in pairs(self.LootKeywords) do
                                if nameLower:find(key) then
                                    isLoot = true
                                    break
                                end
                            end
                            
                            if isLoot and v.Name ~= "Hitbox" and v.Name ~= "WoodenFloor" and not self.Tracking.espLabels[v] then
                                local bg = Instance.new("BillboardGui", v)
                                bg.Name = "SherlockLabel"
                                bg.Size = UDim2.new(0, 120, 0, 50)
                                bg.AlwaysOnTop = true
                                
                                local tl = Instance.new("TextLabel", bg)
                                tl.Size = UDim2.new(1, 0, 1, 0)
                                tl.BackgroundTransparency = 1
                                tl.TextColor3 = Color3.new(0, 1, 1)
                                tl.Text = "[ " .. v.Name .. " ]"
                                tl.Font = Enum.Font.GothamBold
                                tl.TextSize = 11
                                tl.TextStrokeTransparency = 0.5
                                
                                self.Tracking.espLabels[v] = bg
                            end
                        end
                    end
                end)
                task.wait(self.Config.espUpdateSpeed)
            end
        end)
        table.insert(self.Tracking.activeThreads, thread)
    end
end

-- 8. PLAYER ESP
function ApexScript:TogglePlayerEsp(btn)
    self.States.playerEsp = not self.States.playerEsp
    btn.Text = self.States.playerEsp and "PLAYER ESP: ACTIVE" or "PLAYER ESP: OFF"
    
    if not self.States.playerEsp then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("PlayerHighlight") then
                p.Character.PlayerHighlight:Destroy()
            end
            if self.Tracking.playerLabels[p] and self.Tracking.playerLabels[p].Parent then
                self.Tracking.playerLabels[p]:Destroy()
            end
        end
        self.Tracking.playerHighlights = {}
        self.Tracking.playerLabels = {}
    else
        local thread = task.spawn(function()
            while self.States.playerEsp do
                self:SafeCall(function()
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local char = p.Character
                            
                            -- Highlight
                            local hl = char:FindFirstChild("PlayerHighlight") or Instance.new("Highlight", char)
                            hl.Name = "PlayerHighlight"
                            hl.FillColor = Color3.new(0.5, 0, 1)
                            hl.OutlineColor = Color3.new(1, 1, 1)
                            
                            -- Label
                            if not char.HumanoidRootPart:FindFirstChild("PlayerLabel") then
                                local b = Instance.new("BillboardGui", char.HumanoidRootPart)
                                b.Name = "PlayerLabel"
                                b.Size = UDim2.new(0, 150, 0, 50)
                                b.AlwaysOnTop = true
                                b.ExtentsOffset = Vector3.new(0, 3, 0)
                                
                                local t = Instance.new("TextLabel", b)
                                t.Size = UDim2.new(1, 0, 1, 0)
                                t.BackgroundTransparency = 1
                                t.TextColor3 = Color3.new(1, 1, 1)
                                t.Font = Enum.Font.GothamBold
                                t.TextSize = 12
                                t.TextStrokeTransparency = 0
                                
                                task.spawn(function()
                                    while char:FindFirstChild("HumanoidRootPart") and self.States.playerEsp and p.Parent do
                                        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                                            local dist = math.floor((LP.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude)
                                            t.Text = p.Name .. " [" .. dist .. "m]"
                                        end
                                        task.wait(self.Config.playerEspUpdateSpeed)
                                    end
                                    if b and b.Parent then
                                        b:Destroy()
                                    end
                                end)
                                
                                self.Tracking.playerLabels[p] = b
                            end
                        end
                    end
                end)
                task.wait(self.Config.playerEspUpdateSpeed)
            end
        end)
        table.insert(self.Tracking.activeThreads, thread)
    end
end

-- ====== CLEANUP ======
function ApexScript:Cleanup()
    -- Desativar todos os states
    self.States.bringMetals = false
    self.States.bringItems = false
    self.States.speedHack = false
    self.States.fly = false
    self.States.itemEsp = false
    self.States.playerEsp = false
    
    -- Parar threads ativas
    for _, thread in pairs(self.Tracking.activeThreads) do
        task.cancel(thread)
    end
    self.Tracking.activeThreads = {}
    
    -- Restaurar gravidade
    workspace.Gravity = self.OriginalGravity
    
    -- Restaurar velocidade
    if self:IsValidCharacter(LP.Character) then
        LP.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
    end
    
    -- Limpar ESP
    for _, label in pairs(self.Tracking.espLabels) do
        if label and label.Parent then
            label:Destroy()
        end
    end
    
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("PlayerHighlight") then
            p.Character.PlayerHighlight:Destroy()
        end
    end
    
    self.Tracking.espLabels = {}
    self.Tracking.playerHighlights = {}
    self.Tracking.playerLabels = {}
end

-- ====== INICIALIZAÇÃO ======
function ApexScript:Initialize()
    print("[Sherlock Apex] Iniciando...")
    
    local contentFrame = self:BuildUI()
    
    -- Botões
    self:MakeButton("BRING METALS: OFF", function(btn) self:ToggleBringMetals(btn) end)
    self:MakeButton("BRING ITEMS: OFF", function(btn) self:ToggleBringItems(btn) end)
    self:MakeButton("SPEED HACK: OFF", function(btn) self:ToggleSpeedHack(btn) end)
    self:MakeButton("VOAR: OFF", function(btn) self:ToggleFly(btn) end)
    self:MakeButton("INF JUMP: OFF", function(btn) self:ToggleInfiniteJump(btn) end)
    
    self:MakeButton("INSTANT INTERACT", function(btn)
        if self:InstantInteract() then
            btn.Text = "INTERACT: SUCCESS"
            task.wait(2)
            btn.Text = "INSTANT INTERACT"
        else
            btn.Text = "INTERACT: NO EXPLOIT"
            task.wait(2)
            btn.Text = "INSTANT INTERACT"
        end
    end)
    
    self:MakeButton("ITEM ESP: OFF", function(btn) self:ToggleItemEsp(btn) end)
    self:MakeButton("PLAYER ESP: OFF", function(btn) self:TogglePlayerEsp(btn) end)
    self:MakeButton("EXIT", function() self:Cleanup(); self.UI.Hub:Destroy() end)
    
    -- Inicializar infinite jump listener
    self:InitializeInfiniteJump()
    
    print("[Sherlock Apex] Inicializado com sucesso!")
end

