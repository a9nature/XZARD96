-- ====== SERVIÇOS E VARIÁVEIS GLOBAIS ======
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ====== CLASSE PRINCIPAL ======
local ApexScript = {}
ApexScript.__index = ApexScript

function ApexScript.new()
    local self = setmetatable({}, ApexScript)
    
    self.Config = { bringItemsSpeed = 1.5, espUpdateSpeed = 2, playerEspUpdateSpeed = 0.1, bringRange = 2000, maxCacheSize = 10 }
    self.States = { bringMetals = false, bringItems = false, speedHack = false, fly = false, infJump = false, itemEsp = false, playerEsp = false, multiplyFloors = false }
    self.Tracking = { broughtItems = {}, espLabels = {}, playerHighlights = {}, playerLabels = {}, activeThreads = {}, multipliedFloors = {} }
    
    self.OriginalGravity = workspace.Gravity
    self.FlySpeedMultiplier = 5
    self.CustomSpeedValue = 200
    
    self.MetaisParaTrazer = {"Metal", "ScrapMetal", "ESP Metal"}
    self.ItensParaTrazer = {"Box", "BrokenCrate", "BrokenCrate2", "Plank"}
    self.ArmasSuportadas = {"Machete", "Machado", "Arpão", "Machete ", "Machado ", "Arpão ", "Sword", "Espada"}
    self.LootKeywords = {"wood", "plastic", "scrap", "metal", "barrel", "crate", "box", "plank", "bolt", "leaf", "chest"}
    
    self.UI = {}
    self.MinimizedState = false
    
    return self
end

-- ====== UTILITÁRIOS ======
function ApexScript:SafeCall(func, ...)
    local success, result = pcall(func, ...)
    if not success then warn("[Sherlock] Erro: " .. tostring(result)) end
    return result
end

function ApexScript:IsValidCharacter(character)
    return character and character.Parent and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid")
end

-- ====== REUSO DE MEMÓRIA (OTIMIZAÇÃO) ======
function ApexScript:Cleanup()
    self.States.bringMetals = false
    self.States.bringItems = false
    self.States.speedHack = false
    self.States.fly = false
    self.States.itemEsp = false
    self.States.playerEsp = false
    self.States.multiplyFloors = false
    
    for _, thread in pairs(self.Tracking.activeThreads) do pcall(task.cancel, thread) end
    self.Tracking.activeThreads = {}
    
    workspace.Gravity = self.OriginalGravity
    if self:IsValidCharacter(LP.Character) then LP.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16 end
    
    -- OTIMIZAÇÃO: Limpeza de tabelas sem destruir o objeto tabela (Reuso de memória)
    table.clear(self.Tracking.broughtItems)
    table.clear(self.Tracking.espLabels)
    table.clear(self.Tracking.playerHighlights)
    table.clear(self.Tracking.playerLabels)
    table.clear(self.Tracking.multipliedFloors)
    
    print("[Sherlock Apex] Memória limpa e threads paradas.")
end

-- ====== MÉTODOS DE UI ======
function ApexScript:BuildUI()
    local ApexHub = Instance.new("ScreenGui", game:GetService("CoreGui")); ApexHub.Name = "Apex_V94"
    local Main = Instance.new("Frame", ApexHub); Main.Name = "MainFrame"; Main.BackgroundColor3 = Color3.fromRGB(12, 12, 18); Main.Position = UDim2.new(0.5, -130, 0.5, -200); Main.Size = UDim2.new(0, 260, 0, 440); Main.Active = true
    
    -- Sistema de arrastar (Lightweight)
    local dragging, dragStart, startPos
    Main.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; dragStart = input.Position; startPos = Main.Position end end)
    UIS.InputChanged:Connect(function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + (input.Position.X - dragStart.X), startPos.Y.Scale, startPos.Y.Offset + (input.Position.Y - dragStart.Y)) end end)
    UIS.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 15)
    local Content = Instance.new("ScrollingFrame", Main); Content.Position = UDim2.new(0, 15, 0, 60); Content.Size = UDim2.new(1, -30, 1, -75); Content.BackgroundTransparency = 1; Content.ScrollBarThickness = 3
    local UIList = Instance.new("UIListLayout", Content); UIList.Padding = UDim.new(0, 8)
    UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Content.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y + 20) end)
    
    self.UI.Hub = ApexHub; self.UI.Content = Content
    return Content
end

function ApexScript:MakeButton(text, callback)
    local btn = Instance.new("TextButton", self.UI.Content); btn.Size = UDim2.new(1, 0, 0, 45); btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35); btn.Text = text; btn.TextColor3 = Color3.new(1, 1, 1); btn.Font = Enum.Font.GothamBold; btn.TextSize = 10; btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.MouseButton1Click:Connect(function() callback(btn) end)
end

-- ====== INICIALIZAÇÃO ======
function ApexScript:Initialize()
    self:BuildUI()
    self:MakeButton("BRING METALS: OFF", function(btn) self:ToggleBringMetals(btn) end)
    self:MakeButton("BRING ITEMS: OFF", function(btn) self:ToggleBringItems(btn) end)
    self:MakeButton("SPEED HACK: OFF", function(btn) self:ToggleSpeedHack(btn) end)
    self:MakeButton("VOAR: OFF", function(btn) self:ToggleFly(btn) end)
    self:MakeButton("INF JUMP: OFF", function(btn) self:ToggleInfiniteJump(btn) end)
    self:MakeButton("MULTIPLY FLOORS: OFF", function(btn) self:ToggleMultiplyFloors(btn) end)
    self:MakeButton("INSTANT INTERACT", function() self:InstantInteract() end)
    self:MakeButton("EXIT", function() self:Cleanup(); self.UI.Hub:Destroy() end)
    
    -- Inicialização global para controle externo
    getgenv().SherlockApex = self
    print("[Sherlock Apex] Inicializado. Acesso global: getgenv().SherlockApex")
end

-- ====== EXECUÇÃO ======
local apex = ApexScript.new()
apex:Initialize()
