        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("PlayerHighlight") then p.Character.PlayerHighlight:Destroy() end
            if self.Tracking.playerLabels[p] and self.Tracking.playerLabels[p].Parent then self.Tracking.playerLabels[p]:Destroy() end
        end
        self.Tracking.playerHighlights = setmetatable({}, {__mode = "k"})
        self.Tracking.playerLabels = setmetatable({}, {__mode = "k"})
    else
        local thread = task.spawn(function()
            while self.States.playerEsp do
                self:SafeCall(function()
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local char = p.Character
                            local hl = char:FindFirstChild("PlayerHighlight") or Instance.new("Highlight", char)
                            hl.Name = "PlayerHighlight"; hl.FillColor = Color3.new(0.5, 0, 1); hl.OutlineColor = Color3.new(1, 1, 1)
                            
                            if not char.HumanoidRootPart:FindFirstChild("PlayerLabel") then
                                local b = Instance.new("BillboardGui", char.HumanoidRootPart)
                                b.Name = "PlayerLabel"; b.Size = UDim2.new(0, 150, 0, 50); b.AlwaysOnTop = true; b.ExtentsOffset = Vector3.new(0, 3, 0)
                                
                                local t = Instance.new("TextLabel", b)
                                t.Size = UDim2.new(1, 0, 1, 0); t.BackgroundTransparency = 1; t.TextColor3 = Color3.new(1, 1, 1)
                                t.Font = Enum.Font.GothamBold; t.TextSize = 12
                                
                                task.spawn(function()
                                    while char:FindFirstChild("HumanoidRootPart") and self.States.playerEsp and p.Parent do
                                        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then 
                                            t.Text = p.Name .. " [" .. math.floor((LP.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude) .. "m]" 
                                        end
                                        task.wait(self.Config.playerEspUpdateSpeed)
                                    end
                                    if b and b.Parent then b:Destroy() end
                                end)
                                self.Tracking.playerLabels[p] = b
                            end
                        end
                    end
                end)
                task.wait(self.Config.playerEspUpdateSpeed)
            end
        end)
        table.insert(self.Tracking.activeThreads, thread)
    end
end

-- ====== CLEANUP ======
function ApexScript:Cleanup()
    self.States.bringMetals = false
    self.States.bringItems = false
    self.States.speedHack = false
    self.States.fly = false
    self.States.itemEsp = false
    self.States.playerEsp = false
    self.States.killAura = false
    
    for _, thread in pairs(self.Tracking.activeThreads) do pcall(function() task.cancel(thread) end) end
    self.Tracking.activeThreads = {}
    
    workspace.Gravity = self.OriginalGravity
    
    for _, label in pairs(self.Tracking.espLabels) do if label and label.Parent then label:Destroy() end end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("PlayerHighlight") then p.Character.PlayerHighlight:Destroy() end
    end
    
    table.clear(self.CacheMetals)
    table.clear(self.CacheItems)
    self.Tracking.espLabels = setmetatable({}, {__mode = "k"})
    self.Tracking.playerHighlights = setmetatable({}, {__mode = "k"})
    self.Tracking.playerLabels = setmetatable({}, {__mode = "k"})
end

-- ====== INICIALIZAÇÃO ======
function ApexScript:Initialize()
    local contentFrame = self:BuildUI()
    
    self:MakeButton("BRING METALS: OFF", function(btn) self:ToggleBringMetals(btn) end)
    self:MakeButton("BRING ITEMS: OFF", function(btn) self:ToggleBringItems(btn) end)
    self:MakeButton("SPEED HACK: OFF", function(btn) self:ToggleSpeedHack(btn) end)
    self:MakeButton("VOAR: OFF", function(btn) self:ToggleFly(btn) end)
    self:MakeButton("INF JUMP: OFF", function(btn) self:ToggleInfiniteJump(btn) end)
    
    -- Combate e Interação
    self:MakeButton("KILL AURA: OFF", function(btn) self:ToggleKillAura(btn) end)
    self:BuildSlider()
    
    self:MakeButton("INSTANT INTERACT", function(btn)
        if self:InstantInteract() then 
            btn.Text = "INTERACT: SUCCESS"; task.wait(2); btn.Text = "INSTANT INTERACT"
        else 
            btn.Text = "INTERACT: NO EXPLOIT"; task.wait(2); btn.Text = "INSTANT INTERACT" 
        end
    end)
    
    self:MakeButton("ITEM ESP: OFF", function(btn) self:ToggleItemEsp(btn) end)
    self:MakeButton("PLAYER ESP: OFF", function(btn) self:TogglePlayerEsp(btn) end)
    self:MakeButton("EXIT", function() self:Cleanup(); self.UI.Hub:Destroy() end)
    
    self:InitializeInfiniteJump()
end

-- ====== EXECUÇÃO ======
local apex = ApexScript.new()
apex:Initialize()
