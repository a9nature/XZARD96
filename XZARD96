--[[
    SHERLOCK APEX V94 - UNIVERSAL EDITION
    - Compatível com qualquer executor.
    - Interface movida para PlayerGui (Seguro).
    - Lógica de clique simplificada.
]]

local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")
local Mouse = LP:GetMouse()

-- Estrutura simples para evitar erro de classe
local ScreenGui = Instance.new("ScreenGui", PlayerGui)
ScreenGui.Name = "ApexMenu"

local Main = Instance.new("Frame", ScreenGui)
Main.Size = UDim2.new(0, 200, 0, 300)
Main.Position = UDim2.new(0.5, -100, 0.5, -150)
Main.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Main.Active = true
Main.Draggable = true

local Content = Instance.new("ScrollingFrame", Main)
Content.Size = UDim2.new(1, 0, 1, 0)
Content.BackgroundTransparency = 1
Instance.new("UIListLayout", Content).Padding = UDim.new(0, 5)

-- Funções simplificadas
local States = { bring = false, speed = false }

local function addButton(txt, callback)
    local btn = Instance.new("TextButton", Content)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Text = txt
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.MouseButton1Click:Connect(callback)
end

-- BRING SIMPLIFICADO (Teste de funcionalidade)
addButton("BRING ITEMS: OFF", function(btn)
    States.bring = not States.bring
    btn.Text = States.bring and "BRING: ACTIVE" or "BRING: OFF"
    task.spawn(function()
        while States.bring do
            local char = LP.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                for _, v in pairs(workspace:GetDescendants()) do
                    if (v.Name == "Plank" or v.Name == "Box") and v:IsA("BasePart") and not v.Anchored then
                        v.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)
                    end
                end
            end
            task.wait(1)
        end
    end)
end)

-- SPEED CAMUFLADO
addButton("SPEED: OFF", function(btn)
    States.speed = not States.speed
    btn.Text = States.speed and "SPEED: ACTIVE" or "SPEED: OFF"
    task.spawn(function()
        while States.speed and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") do
            local hum = LP.Character.Humanoid
            if hum.MoveDirection.Magnitude > 0 then
                LP.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(hum.MoveDirection.X * 100, 0, hum.MoveDirection.Z * 100)
            end
            task.wait(0.01)
        end
    end)
end)

addButton("EXIT", function() ScreenGui:Destroy() end)
