end

function ApexScript:ToggleMinimize()
    self.MinimizedState = not self.MinimizedState
    if self.MinimizedState then
        self.UI.Main:TweenSize(UDim2.new(0, 260, 0, 50), Enum.EasingDirection.InOut, Enum.EasingStyle.Quad, 0.3, true)
        self.UI.Content.Visible = false
        self.UI.MinimizeBtn.Text = "+"
    else
        self.UI.Main:TweenSize(self.UI.OriginalSize, Enum.EasingDirection.InOut, Enum.EasingStyle.Quad, 0.3, true)
        self.UI.Content.Visible = true
        self.UI.MinimizeBtn.Text = "−"
    end
end

