-- 6. KILL AURA INTEGRADA POO
local function AutoEquipWeapon(self)
    local localCharacter = LP.Character
    if not localCharacter then return nil end
    local ferramentaAtual = localCharacter:FindFirstChildOfClass("Tool")
    if ferramentaAtual then
        for _, nomeArma in pairs(self.ArmasSuportadas) do
            if string.find(ferramentaAtual.Name:lower(), nomeArma:lower()) then return ferramentaAtual end
        end
    end
    local backpack = LP:FindFirstChild("Backpack")
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                for _, nomeArma in pairs(self.ArmasSuportadas) do
                    if string.find(item.Name:lower(), nomeArma:lower()) then
                        item.Parent = localCharacter
                        task.wait(0.05)
                        return item
                    end
                end
            end
        end
    end
    return localCharacter:FindFirstChildOfClass("Tool")
end

local function ClickTarget(part)
    local screenPos, onScreen = Camera:WorldToScreenPoint(part.Position)
    if onScreen then
        local vu = game:GetService("VirtualUser") or VirtualUser
        if vu then
            vu:CaptureController()
            vu:Button1Down(Vector2.new(screenPos.X, screenPos.Y), Camera.CFrame)
            vu:Button1Up(Vector2.new(screenPos.X, screenPos.Y), Camera.CFrame)
        end
    end
end

function ApexScript:ToggleKillAura(btn)
    self.States.killAura = not self.States.killAura
    btn.Text = self.States.killAura and "KILL AURA: ACTIVE" or "KILL AURA: OFF"
    
    if self.States.killAura then
        local thread = task.spawn(function()
            while self.States.killAura do
                if self:IsValidCharacter(LP.Character) then
                    local playerPos = LP.Character.HumanoidRootPart.Position
                    
                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("Model") and v ~= LP.Character then
                            local targetPart = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Hitbox") or v:FindFirstChild("Head") or v.PrimaryPart
                            
                            if targetPart and targetPart:IsA("BasePart") then
                                local distance = (playerPos - targetPart.Position).Magnitude
                                
                                if distance <= self.KillAuraRange then
                                    local targetPlayer = Players:GetPlayerFromCharacter(v)
                                    if not (targetPlayer and targetPlayer.Team == LP.Team and LP.Team ~= nil) then
                                        
                                        local tool = AutoEquipWeapon(self)
                                        if tool then tool:Activate() end
                                        
                                        ClickTarget(targetPart)
                                        
                                        if tool and tool:FindFirstChild("Handle") then
                                            firetouchinterest(targetPart, tool.Handle, 0)
                                            firetouchinterest(targetPart, tool.Handle, 1)
                                        end
                                        
                                        local hum = v:FindFirstChildOfClass("Humanoid")
                                        if hum and hum.Health > 0 then
                                            hum:TakeDamage(hum.MaxHealth)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                task.wait(0.05)
            end
        end)
        table.insert(self.Tracking.activeThreads, thread)
    end
end

-- 7. INSTANT INTERACT
function ApexScript:InstantInteract()
    local exploit = self:GetExploitFunctions()
    if exploit.getgc then
        for _, v in pairs(exploit.getgc(true)) do
            if type(v) == "table" and (rawget(v, "CollectionTime") or rawget(v, "HoldTime")) then
                v.CollectionTime = 0
                v.HoldTime = 0
            end
        end
        return true
    end
    return false
end

-- 8. ITEM ESP
function ApexScript:ToggleItemEsp(btn)
    self.States.itemEsp = not self.States.itemEsp
    btn.Text = self.States.itemEsp and "ITEM ESP: ACTIVE" or "ITEM ESP: OFF"
    
    if not self.States.itemEsp then
        for _, label in pairs(self.Tracking.espLabels) do if label and label.Parent then label:Destroy() end end
        self.Tracking.espLabels = setmetatable({}, {__mode = "k"})
    else
        local thread = task.spawn(function()
            while self.States.itemEsp do
                self:SafeCall(function()
                    for _, v in pairs(workspace:GetDescendants()) do
                        if (v:IsA("BasePart") or v:IsA("Model")) and v.Parent and v.Name ~= "Hitbox" and v.Name ~= "WoodenFloor" then
                            local nameLower = v.Name:lower()
                            local isLoot = false
                            
                            for _, key in pairs(self.LootKeywords) do
                                if nameLower:find(key) then isLoot = true; break end
                            end
                            
                            if isLoot and not self.Tracking.espLabels[v] then
                                local bg = Instance.new("BillboardGui", v)
                                bg.Name = "SherlockLabel"; bg.Size = UDim2.new(0, 120, 0, 50); bg.AlwaysOnTop = true
                                
                                local tl = Instance.new("TextLabel", bg)
                                tl.Size = UDim2.new(1, 0, 1, 0); tl.BackgroundTransparency = 1; tl.TextColor3 = Color3.new(0, 1, 1)
                                tl.Text = "[ " .. v.Name .. " ]"; tl.Font = Enum.Font.GothamBold; tl.TextSize = 11; tl.TextStrokeTransparency = 0.5
                                
                                self.Tracking.espLabels[v] = bg
                            end
                        end
                    end
                end)
                task.wait(self.Config.espUpdateSpeed)
            end
        end)
        table.insert(self.Tracking.activeThreads, thread)
    end
end

