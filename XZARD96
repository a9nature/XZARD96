-- Função auxiliar para mover objetos
function ApexScript:MoveObject(obj, targetCFrame)
    if obj:IsA("Model") then
        for _, part in pairs(obj:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = false
                part.CanCollide = true
                part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
        if obj.PrimaryPart then
            obj:SetPrimaryPartCFrame(targetCFrame)
        else
            obj:PivotTo(targetCFrame)
        end
    elseif obj:IsA("BasePart") then
        obj.Anchored = false
        obj.CanCollide = true
        obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        obj.CFrame = targetCFrame
    end
end

-- 3. SPEED HACK
function ApexScript:ToggleSpeedHack(btn)
    self.States.speedHack = not self.States.speedHack
    btn.Text = self.States.speedHack and "SPEED: 5X ACTIVE" or "SPEED HACK: OFF"
    
    local thread = task.spawn(function()
        while self.States.speedHack do
            self:SafeCall(function()
                if self:IsValidCharacter(LP.Character) then
                    LP.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 995
                end
            end)
            task.wait(0.1)
        end
        if self:IsValidCharacter(LP.Character) then
            LP.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
        end
    end)
    table.insert(self.Tracking.activeThreads, thread)
end

-- 4. FLY COM SPEED HACK INTEGRADO
function ApexScript:ToggleFly(btn)
    self.States.fly = not self.States.fly
    btn.Text = self.States.fly and "VOAR: ACTIVE" or "VOAR: OFF"
    
    if self.States.fly then
        local thread = task.spawn(function()
            if self:IsValidCharacter(LP.Character) then
                local hum = LP.Character:FindFirstChildOfClass("Humanoid")
                local root = LP.Character.HumanoidRootPart
                
                for i = 1, 25 do
                    if not self.States.fly then break end
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 45, root.AssemblyLinearVelocity.Z)
                    task.wait(0.02)
                end
                
                while self.States.fly do
                    self:SafeCall(function()
                        workspace.Gravity = 0
                        -- Speed hack integrado enquanto voa
                        hum.WalkSpeed = 995
                        
                        if root and hum then
                            local moveDirection = hum.MoveDirection
                            if moveDirection.Magnitude > 0 then
                                local flyVelocity = moveDirection * (hum.WalkSpeed * self.FlySpeedMultiplier)
                                root.AssemblyLinearVelocity = Vector3.new(flyVelocity.X, 0, flyVelocity.Z)
                            else
                                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end)
                    task.wait(0.01)
                end
            end
        end)
        table.insert(self.Tracking.activeThreads, thread)
    else
        workspace.Gravity = self.OriginalGravity
        if self:IsValidCharacter(LP.Character) then
            LP.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
        end
    end
end

