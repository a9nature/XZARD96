-- ====== SERVIÇOS E VARIÁVEIS GLOBAIS ======
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ====== CLASSE PRINCIPAL DO SCRIPT ======
local ApexScript = {}
ApexScript.__index = ApexScript

function ApexScript.new()
    local self = setmetatable({}, ApexScript)
    
    -- Configurações
    self.Config = {
        bringItemsSpeed = 1.2,
        espUpdateSpeed = 2,
        playerEspUpdateSpeed = 0.1,
        maxCacheSize = 10,
    }
    
    -- Estados
    self.States = {
        bringMetals = false,
        bringItems = false,
        speedHack = false,
        fly = false,
        infJump = false,
        itemEsp = false,
        playerEsp = false,
        killAura = false,
    }
    
    -- Variáveis de Combate e Movimentação
    self.KillAuraRange = 500
    self.OriginalGravity = workspace.Gravity
    self.FlySpeedMultiplier = 5
    self.CustomSpeedValue = 200
    
    -- Caches Históricos Rotativos para evitar o efeito ioiô
    self.CacheMetals = {}
    self.CacheItems = {}
    
    -- Rastreamento - apenas para limpeza de ESP e Threads
    self.Tracking = {
        espLabels = setmetatable({}, {__mode = "k"}),
        playerHighlights = setmetatable({}, {__mode = "k"}),
        playerLabels = setmetatable({}, {__mode = "k"}),
        activeThreads = {},
    }
    
    -- Configurações de itens - FILTROS ESTRITOS SOLICITADOS
    self.MetaisParaTrazer = {"Metal", "ScrapMetal", "ESP Metal"}
    self.ItensParaTrazer = {"Box", "BrokenCrate", "BrokenCrate2", "Plank"}
    self.ArmasSuportadas = {"Machete", "Machado", "Arpão", "Machete ", "Machado ", "Arpão ", "Sword", "Espada"}
    self.LootKeywords = {"wood", "plastic", "scrap", "metal", "barrel", "crate", "box", "plank", "bolt", "leaf", "chest"}
    
    -- UI
    self.UI = {}
    self.MinimizedState = false
    
    return self
end

-- ====== UTILITÁRIOS ======
function ApexScript:SafeCall(func, ...)
    local success, result = pcall(func, ...)
    if not success then
        warn("[Sherlock] Erro: " .. tostring(result))
    end
    return result
end

function ApexScript:IsValidCharacter(character)
    return character and character.Parent and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid")
end

function ApexScript:IsTeammate(player)
    if not player then return false end
    local localPlayer = Players.LocalPlayer
    if not localPlayer.Team then return false end
    return player.Team == localPlayer.Team
end

-- Gerenciador do Cache Histórico Rotativo (Fila FIFO de 10 objetos)
function ApexScript:ManageCache(cacheTable, object)
    if table.find(cacheTable, object) then return true end
    if #cacheTable >= self.Config.maxCacheSize then
        table.remove(cacheTable, 1)
    end
    table.insert(cacheTable, object)
    return false
end

-- ====== FUNÇÕES DE EXPLOIT (COM FALLBACKS) ======
function ApexScript:GetExploitFunctions()
    local virtUser = nil
    local getGarbageCollector = nil
    
    if typeof(VirtualUser) == "userdata" then
        virtUser = VirtualUser
    elseif game:FindFirstChildOfClass("VirtualUser") then
        virtUser = game:FindFirstChildOfClass("VirtualUser")
    else
        pcall(function()
            virtUser = game:GetService("VirtualUser")
        end)
    end
    
    if type(getgc) == "function" then
        getGarbageCollector = getgc
    end
    
    return {
        VirtualUser = virtUser,
        getgc = getGarbageCollector,
    }
end

