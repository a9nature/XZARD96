function ApexScript:MoveObject(obj, targetCFrame)
    if obj:IsA("Model") then
        for _, part in pairs(obj:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = true
                part.CanCollide = false
                part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
        if obj.PrimaryPart then obj:SetPrimaryPartCFrame(targetCFrame) else obj:PivotTo(targetCFrame) end
    elseif obj:IsA("BasePart") then
        obj.Anchored = true; obj.CanCollide = false
        obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0); obj.CFrame = targetCFrame
    end
end

function ApexScript:EnablePhysics(obj)
    local microImpulso = Vector3.new(0, -5, 0)
    if obj:IsA("Model") then
        for _, part in pairs(obj:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = false
                part.CanCollide = true
                part.AssemblyLinearVelocity = microImpulso
            end
        end
    elseif obj:IsA("BasePart") then
        obj.Anchored = false
        obj.CanCollide = true
        obj.AssemblyLinearVelocity = microImpulso
    end
end

-- 3. SPEED HACK VETORIAL SEGURO
function ApexScript:ToggleSpeedHack(btn)
    self.States.speedHack = not self.States.speedHack
    btn.Text = self.States.speedHack and "SPEED: 5X ACTIVE" or "SPEED HACK: OFF"
    
    local thread = task.spawn(function()
        while self.States.speedHack do
            self:SafeCall(function()
                local localPlayer = Players.LocalPlayer
                if self:IsValidCharacter(localPlayer.Character) then
                    local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
                    local root = localPlayer.Character.HumanoidRootPart
                    local direcaoMove = hum.MoveDirection
                    
                    if direcaoMove.Magnitude > 0 then
                        root.AssemblyLinearVelocity = Vector3.new(direcaoMove.X * self.CustomSpeedValue, root.AssemblyLinearVelocity.Y, direcaoMove.Z * self.CustomSpeedValue)
                    end
                end
            end)
            task.wait(0.01)
        end
    end)
    table.insert(self.Tracking.activeThreads, thread)
end

-- 4. FLY COM VELOCIDADE VETORIAL INTEGRADA
function ApexScript:ToggleFly(btn)
    self.States.fly = not self.States.fly
    btn.Text = self.States.fly and "VOAR: ACTIVE" or "VOAR: OFF"
    
    if self.States.fly then
        local thread = task.spawn(function()
            local localPlayer = Players.LocalPlayer
            if self:IsValidCharacter(localPlayer.Character) then
                local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
                local root = localPlayer.Character.HumanoidRootPart
                
                for i = 1, 25 do
                    if not self.States.fly then break end
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 45, root.AssemblyLinearVelocity.Z)
                    task.wait(0.02)
                end
                
                while self.States.fly do
                    self:SafeCall(function()
                        workspace.Gravity = 0
                        if root and hum then
                            local moveDirection = hum.MoveDirection
                            if moveDirection.Magnitude > 0 then
                                local flyVelocity = moveDirection * (self.CustomSpeedValue * self.FlySpeedMultiplier)
                                root.AssemblyLinearVelocity = Vector3.new(flyVelocity.X, 0, flyVelocity.Z)
                            else
                                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end)
                    task.wait(0.01)
                end
            end
        end)
        table.insert(self.Tracking.activeThreads, thread)
    else
        workspace.Gravity = self.OriginalGravity
    end
end

