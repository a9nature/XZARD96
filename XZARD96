-- 6. KILL AURA INTEGRADA POO (CORRIGIDA)
local function AutoEquipWeapon(self)
    local localPlayer = Players.LocalPlayer
    if not localPlayer.Character then return nil end
    local ferramentaAtual = localPlayer.Character:FindFirstChildOfClass("Tool")
    if ferramentaAtual then
        for _, nomeArma in pairs(self.ArmasSuportadas) do
            if string.find(ferramentaAtual.Name:lower(), nomeArma:lower()) then return ferramentaAtual end
        end
    end
    local backpack = localPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                for _, nomeArma in pairs(self.ArmasSuportadas) do
                    if string.find(item.Name:lower(), nomeArma:lower()) then
                        item.Parent = localPlayer.Character
                        task.wait(0.05)
                        return item
                    end
                end
            end
        end
    end
    return localPlayer.Character:FindFirstChildOfClass("Tool")
end

