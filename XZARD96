    else
        self.UI.Main:TweenSize(self.UI.OriginalSize, Enum.EasingDirection.InOut, Enum.EasingStyle.Quad, 0.3, true)
        self.UI.Content.Visible = true
        self.UI.MinimizeBtn.Text = "−"
    end
