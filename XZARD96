function ApexScript:BuildUI()
    local ApexHub = Instance.new("ScreenGui")
    ApexHub.Name = "Apex_V94_Improved"
    ApexHub.Parent = game:GetService("CoreGui")
    
    local Main = Instance.new("Frame")
    Main.Name = "MainFrame"
    Main.Parent = ApexHub
    Main.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
    Main.BorderSizePixel = 0
    Main.Position = UDim2.new(0.5, -130, 0.5, -200)
    Main.Size = UDim2.new(0, 260, 0, 440)
    Main.Active = true
    
    -- Sistema de Arrastar Alternativo Seguro (Anti-Crash)
    local dragging, dragInput, dragStart, startPos
    Main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    Main.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 15)
    UICorner.Parent = Main
    
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Thickness = 3
    UIStroke.Color = Color3.fromRGB(0, 255, 120)
    UIStroke.Parent = Main
    
    local Title = Instance.new("TextLabel")
    Title.Parent = Main
    Title.Size = UDim2.new(0.85, 0, 0, 50)
    Title.Position = UDim2.new(0, 10, 0, 5)
    Title.Text = "SHERLOCK APEX V94 ULTRA"
    Title.TextColor3 = Color3.new(1, 1, 1)
    Title.Font = Enum.Font.GothamBlack
    Title.TextSize = 16
    Title.BackgroundTransparency = 1
    
    local MinimizeBtn = Instance.new("TextButton")
    MinimizeBtn.Parent = Main
    MinimizeBtn.Size = UDim2.new(0, 40, 0, 40)
    MinimizeBtn.Position = UDim2.new(1, -45, 0, 5)
    MinimizeBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
    MinimizeBtn.Text = "−"
    MinimizeBtn.TextColor3 = Color3.fromRGB(12, 12, 18)
    MinimizeBtn.Font = Enum.Font.GothamBold
    MinimizeBtn.TextSize = 24
    MinimizeBtn.BorderSizePixel = 0
    
    local minCorner = Instance.new("UICorner")
    minCorner.CornerRadius = UDim.new(0, 8)
    minCorner.Parent = MinimizeBtn
    
    local Content = Instance.new("ScrollingFrame")
    Content.Parent = Main
    Content.Position = UDim2.new(0, 15, 0, 60)
    Content.Size = UDim2.new(1, -30, 1, -75)
    Content.BackgroundTransparency = 1
    Content.ScrollBarThickness = 3
    Content.ScrollBarImageColor3 = Color3.fromRGB(0, 255, 120)
    
    local UIList = Instance.new("UIListLayout")
    UIList.Parent = Content
    UIList.Padding = UDim.new(0, 8)
    
    -- Rolagem dinâmica automática baseada no conteúdo real
    UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Content.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y + 20)
    end)
    
    self.UI.Hub = ApexHub
    self.UI.Main = Main
    self.UI.Content = Content
    self.UI.Title = Title
    self.UI.MinimizeBtn = MinimizeBtn
    self.UI.OriginalSize = Main.Size
    
    MinimizeBtn.MouseButton1Click:Connect(function()
        self:ToggleMinimize()
    end)
    
